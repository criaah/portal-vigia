<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="vigia-defs" targetNamespace="https://inger.cl/vigia" exporter="VIGIA" exporterVersion="v13">
<signal id="sig_alta" name="Alta probable"/>
<collaboration id="collab_vigia"><participant id="pool_vigia" name="Piloto VIGÍA · UGA INGER (v13)" processRef="proc_vigia"/></collaboration>
<process id="proc_vigia" name="Seguimiento post-alta VIGÍA" isExecutable="false">
<laneSet id="ls_vigia">
<lane id="L1" name="Revisión de ingresos"><documentation>EU UGA · coordinación</documentation><flowNodeRef>ev_ing</flowNodeRef><flowNodeRef>t_check</flowNodeRef><flowNodeRef>g_cand</flowNodeRef><flowNodeRef>e_nocand</flowNodeRef><flowNodeRef>t_lista</flowNodeRef></lane>
<lane id="L2" name="Seguimiento hospitalario"><documentation>EU ADG · KGO</documentation><flowNodeRef>ev_alta</flowNodeRef><flowNodeRef>t_pre</flowNodeRef><flowNodeRef>g_entra</flowNodeRef><flowNodeRef>e_noentra</flowNodeRef><flowNodeRef>t_a1</flowNodeRef><flowNodeRef>t_fol</flowNodeRef></lane>
<lane id="L3" name="Gestión de Casos"><documentation>EU gestoras de casos · Ana González (titular del aviso de altas) y Kattalina Matteo (suplente)</documentation><flowNodeRef>ev_dia</flowNodeRef><flowNodeRef>t_aviso</flowNodeRef><flowNodeRef>ev_sig</flowNodeRef><flowNodeRef>g_mrg</flowNodeRef><flowNodeRef>ev_tim</flowNodeRef><flowNodeRef>t_ll</flowNodeRef><flowNodeRef>g_res</flowNodeRef><flowNodeRef>t_urg</flowNodeRef><flowNodeRef>g_mas</flowNodeRef></lane>
<lane id="L4" name="Médico post-alta / UGA"><documentation>Médico post-alta telefónico</documentation><flowNodeRef>t_med</flowNodeRef></lane>
<lane id="L5" name="Coordinación VIGÍA"><documentation>Coordinación del piloto</documentation><flowNodeRef>t_30</flowNodeRef><flowNodeRef>e_fin</flowNodeRef><flowNodeRef>ev_sem</flowNodeRef><flowNodeRef>t_sem</flowNodeRef><flowNodeRef>e_sem</flowNodeRef></lane>
</laneSet>
<startEvent id="ev_ing" name="Paciente ingresa a UGA"><outgoing>f0</outgoing></startEvent>
<userTask id="t_check" name="Check de ingreso (≤72 h)"><documentation>4 preguntas sí/no: ¿irá a domicilio? ¿sin HOSDOM? ¿sin exclusión (paliativos, traslado, sin red ni teléfono)? ¿tiene teléfono de contacto? Sin Barthel ni fecha de alta.</documentation><incoming>f0</incoming><outgoing>f1</outgoing></userTask>
<exclusiveGateway id="g_cand" name="¿Candidato?"><incoming>f1</incoming><outgoing>f2</outgoing><outgoing>f3</outgoing></exclusiveGateway>
<endEvent id="e_nocand" name="No candidato (motivo en 1 clic)"><incoming>f2</incoming></endEvent>
<userTask id="t_lista" name="Agregar a candidatos"><documentation>Nombre, RUT, cama, fecha de ingreso y diagnóstico principal.</documentation><incoming>f3</incoming><outgoing>f4</outgoing></userTask>
<intermediateCatchEvent id="ev_alta" name="Alta probable en 24–48 h"><documentation>Lo recibe Seguimiento hospitalario desde el aviso diario de Gestión de Casos (tarea «Avisar altas probables»).</documentation><incoming>f4</incoming><outgoing>f5</outgoing><signalEventDefinition signalRef="sig_alta"/></intermediateCatchEvent>
<userTask id="t_pre" name="Evaluación prealta y decisión"><documentation>Barthel último (TO/KNT), GLIM, destino, exclusión, CFS basal, n.º de fármacos, cuidador y fecha de alta. El portal calcula ENTRA / NO ENTRA.</documentation><incoming>f5</incoming><outgoing>f6</outgoing></userTask>
<exclusiveGateway id="g_entra" name="¿Entra?"><incoming>f6</incoming><outgoing>f7</outgoing><outgoing>f8</outgoing></exclusiveGateway>
<endEvent id="e_noentra" name="No entra (motivo)"><incoming>f7</incoming></endEvent>
<userTask id="t_a1" name="Atención 1"><documentation>Consentimiento, con quién (cuidador presente), teach-back de 3 dominios (I/R/P), contacto verificado en ficha y celular de Gestión de Casos guardado.</documentation><incoming>f8</incoming><outgoing>f9</outgoing></userTask>
<userTask id="t_fol" name="Entregar folleto y traspaso"><documentation>Folleto de alta. Sin epicrisis: con la receta, y los controles se confirman en la 1.ª llamada. El traspaso genera el mensaje al grupo.</documentation><incoming>f9</incoming><outgoing>f10</outgoing></userTask>
<exclusiveGateway id="g_mrg" name=""><incoming>f10</incoming><incoming>f19</incoming><outgoing>f11</outgoing></exclusiveGateway>
<intermediateCatchEvent id="ev_tim" name="Fecha de llamada: 48–96 h · día 7 · día 14 · día 21"><incoming>f11</incoming><outgoing>f12</outgoing><timerEventDefinition/></intermediateCatchEvent>
<userTask id="t_ll" name="Llamada de seguimiento"><documentation>Hasta 3 intentos. Teach-back de 3 dominios, lista «ojo» del paciente, urgencia o rehospitalización desde el último contacto.</documentation><incoming>f12</incoming><outgoing>f13</outgoing></userTask>
<exclusiveGateway id="g_res" name="¿Qué encontró?"><incoming>f13</incoming><outgoing>f14</outgoing><outgoing>f15</outgoing><outgoing>f16</outgoing></exclusiveGateway>
<userTask id="t_urg" name="Derivar a urgencia o SAMU 131"><incoming>f15</incoming><outgoing>f17</outgoing></userTask>
<userTask id="t_med" name="Evaluar por teléfono o IC a UGA"><documentation>Descompensación o discrepancia de receta. Se devuelve a la UGA: no improvisar dosis.</documentation><incoming>f16</incoming><outgoing>f18</outgoing></userTask>
<exclusiveGateway id="g_mas" name="¿Quedan llamadas?"><incoming>f14</incoming><incoming>f17</incoming><incoming>f18</incoming><outgoing>f19</outgoing><outgoing>f20</outgoing></exclusiveGateway>
<userTask id="t_30" name="Revisión a 30 días y cierre"><documentation>Urgencias, rehospitalización y estado a 30 días en la ficha.</documentation><incoming>f20</incoming><outgoing>f21</outgoing></userTask>
<endEvent id="e_fin" name="Seguimiento cerrado"><incoming>f21</incoming></endEvent>
<startEvent id="ev_sem" name="Cada semana"><outgoing>f22</outgoing><timerEventDefinition/></startEvent>
<userTask id="t_sem" name="Revisar tablero e indicadores (15 min)"><documentation>Pacientes atrasados, captación, altas sin Atención 1, llamadas no logradas.</documentation><incoming>f22</incoming><outgoing>f23</outgoing></userTask>
<endEvent id="e_sem" name=""><incoming>f23</incoming></endEvent>
<sequenceFlow id="f0" sourceRef="ev_ing" targetRef="t_check"/>
<sequenceFlow id="f1" sourceRef="t_check" targetRef="g_cand"/>
<sequenceFlow id="f2" sourceRef="g_cand" targetRef="e_nocand" name="No"/>
<sequenceFlow id="f3" sourceRef="g_cand" targetRef="t_lista" name="Sí"/>
<sequenceFlow id="f4" sourceRef="t_lista" targetRef="ev_alta"/>
<sequenceFlow id="f5" sourceRef="ev_alta" targetRef="t_pre"/>
<sequenceFlow id="f6" sourceRef="t_pre" targetRef="g_entra"/>
<sequenceFlow id="f7" sourceRef="g_entra" targetRef="e_noentra" name="No"/>
<sequenceFlow id="f8" sourceRef="g_entra" targetRef="t_a1" name="Sí"/>
<sequenceFlow id="f9" sourceRef="t_a1" targetRef="t_fol"/>
<sequenceFlow id="f10" sourceRef="t_fol" targetRef="g_mrg"/>
<sequenceFlow id="f11" sourceRef="g_mrg" targetRef="ev_tim"/>
<sequenceFlow id="f12" sourceRef="ev_tim" targetRef="t_ll"/>
<sequenceFlow id="f13" sourceRef="t_ll" targetRef="g_res"/>
<sequenceFlow id="f14" sourceRef="g_res" targetRef="g_mas" name="Sin problema"/>
<sequenceFlow id="f15" sourceRef="g_res" targetRef="t_urg" name="Signo de gravedad"/>
<sequenceFlow id="f16" sourceRef="g_res" targetRef="t_med" name="Descompensación o receta"/>
<sequenceFlow id="f17" sourceRef="t_urg" targetRef="g_mas"/>
<sequenceFlow id="f18" sourceRef="t_med" targetRef="g_mas"/>
<sequenceFlow id="f19" sourceRef="g_mas" targetRef="g_mrg" name="Sí"/>
<sequenceFlow id="f20" sourceRef="g_mas" targetRef="t_30" name="No"/>
<sequenceFlow id="f21" sourceRef="t_30" targetRef="e_fin"/>
<sequenceFlow id="f22" sourceRef="ev_sem" targetRef="t_sem"/>
<sequenceFlow id="f23" sourceRef="t_sem" targetRef="e_sem"/>
<startEvent id="ev_dia" name="Cada mañana hábil · reunión del equipo UGA"><outgoing>f24</outgoing><timerEventDefinition/></startEvent>
<userTask id="t_aviso" name="Avisar altas probables y suspendidas"><documentation>Responsable: Gestión de Casos (Ana González; suplente Kattalina Matteo). Después de la reunión del equipo UGA, avisa en el portal y en el grupo las altas probables de pacientes candidatos o VIGÍA (código VG y cama), las altas suspendidas y las altas con HOSDOM o con exclusión. Si nadie de Gestión de Casos va a la reunión, avisa Seguimiento hospitalario.</documentation><incoming>f24</incoming><outgoing>f25</outgoing></userTask>
<intermediateThrowEvent id="ev_sig" name="Aviso de alta probable"><incoming>f25</incoming><signalEventDefinition signalRef="sig_alta"/></intermediateThrowEvent>
<sequenceFlow id="f24" sourceRef="ev_dia" targetRef="t_aviso"/>
<sequenceFlow id="f25" sourceRef="t_aviso" targetRef="ev_sig"/>
</process>
